[1.992, "o", "\u001b[2;4H\u001b(B\u001b[0;1m\u001b[31m\u001b[40mIronman \u001b[9b(\u001b[37m\u001b[40m0\u001b[31m\u001b[40m)\u001b[3;4H\u001b[33m\u001b[40mFinesse \u001b[9b(\u001b[37m\u001b[40m0\u001b[33m\u001b[40m)\u001b(B\u001b[0m\u001b[37m\u001b[40m  \u001b(0\u001b[0m\u001b[31m\u001b[40mx\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[31m\u001b[40mFinesse\u001b[7;29H\u001b[33m\u001b[40mDance! Dance, bonedaddy!\"\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[26X\u001b[8;28H\u001b[50X\u001b[9dHave you heard of an itchy trigger finger? Yours are\u001b[10;28Hitchier than the chicken pox, and because of that\u001b[11;28Hyou can fire rounds and attack 10% faster with every\u001b[12;28Hlevel of this trait.\u001b[28X\u001b[13;28H\u001b[45X\u001b[14d\u001b[49X\u001b[15d\u001b[50X\u001b[16d\u001b[25X\u001b[H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
