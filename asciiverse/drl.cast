[0.024, "o", "\u001b[5;16H\u001b(B\u001b[0;1m\u001b[33m\u001b[40mWelcome to \u001b[31m\u001b[40mD**m the Roguelike\u001b[33m\u001b[40m!\u001b[7;16HYou are running DRL for the first time. I hope you will find this\u001b[8;16Hroguelike game as enjoyable as it was for me to write it.\u001b[10;16HThis game is in active development (again?), and as such please be\u001b[11;16Halways sure that you have the most recent version, for bugs are fixed,\u001b[12;16Hnew features appear, and the game becomes better at every iteration.\u001b[13;16HYou can find the lastest version on DRL website:\u001b[15;16H\u001b[34m\u001b[40mhttps://drl.chaosforge.org/\u001b[16;21H\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[62X\u001b[17;16H\u001b(B\u001b[0;1m\u001b[33m\u001b[40mAlso, if you enjoy this game, join the Discord and/or the forums:\u001b[19;16H\u001b[34m\u001b[40mhttp://discord.gg/jupiterhell\u001b[20;16Hhttp://forum.chaosforge.org/\u001b[22;16H\u001b[33m\u001b[40mYou can also follow me on X (\u001b[34m\u001b[40m@chaosforge_org\u001b[33m\u001b[40m/\u001b[34m\u001b[40m@epyoncf\u001b[33m\u001b[40m).\u001b[24;16HPress <\u001b[37m\u001b[40mEnter\u001b[33m\u001b[40m> to continue...\u001b[3;11H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[2.731, "o", "\u001b[3;28H\u001b[34m\u001b[40m ###      \u001b[4;28H ######   \u001b[5;16H\u001b[37m\u001b[40m \u001b[11b\u001b[34m\u001b[40m #\u001b[8b\u001b[37m\u001b[40m \u001b[7b\u001b[6;28H\u001b[34m\u001b[40m ### #####\u001b[7;16H\u001b[37m\u001b[40m \u001b[11b\u001b[34m\u001b[40m ###   ##\u001b(B\u001b[0;1m\u001b[33m\u001b[40m#\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[43X\u001b[8;16H \u001b[11b\u001b[34m\u001b[40m ###   #\u001b(B\u001b[0;1m\u001b[33m\u001b[40m##\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[35X\u001b[9;28H\u001b[34m\u001b[40m ### \u001b(B\u001b[0;1m\u001b[33m\u001b[40m  ###\u001b[10;16H\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b[11b\u001b[34m\u001b[40m ###\u001b(B\u001b[0;1m\u001b[33m\u001b[40m   ##\u001b[31m\u001b[40m#\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[44X\u001b[11;16H \u001b[11b\u001b[34m\u001b[40m ##\u001b(B\u001b[0;1m\u001b[33m\u001b[40m#  ##\u001b[31m\u001b[40m#\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[49X\u001b[12;16H \u001b[11b\u001b[34m\u001b[40m #\u001b(B\u001b[0;1m\u001b[33m\u001b[40m## \u001b[31m\u001b[40m###   \u001b(B\u001b[0m\u001b[31m\u001b[40mDRL version \u001b(B\u001b[0;1m\u001b[31m\u001b[40m0.10.12c\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[25X\u001b[13;16H \u001b[11b\u001b(B\u001b[0;1m\u001b[33m\u001b[40m ###\u001b[31m\u001b[40m###    \u001b(B\u001b[0m\u001b[31m\u001b[40mby \u001b(B\u001b[0;1m\u001b[31m\u001b[40mKornel Kisielewicz\u001b(B\u001b[0m\u001b[37m\u001b[40m    \u001b[14;28H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m #\u001b[31m\u001b[40m###      \u001b(B\u001b[0m\u001b[31m\u001b[40mgraphics by \u001b(B\u001b[0;1m\u001b[31m\u001b[40mDerek Yu\u001b[15;16H\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b[11b\u001b(B\u001b[0;1m\u001b[31m\u001b[40m ## \u001b[7b\u001b(B\u001b[0m\u001b[31m\u001b[40mand \u001b(B\u001b[0;1m\u001b[31m\u001b[40mLukasz Sliwinski\u001b[17;13H\u001b(B\u001b[0m\u001b[31m\u001b[40mDRL Engine  : \u001b(B\u001b[0;1m\u001b[33m\u001b[40m0.10.12c\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[46X\u001b[18;13H\u001b[31m\u001b[40mAdd. coding : \u001b(B\u001b[0;1m\u001b[33m\u001b[40mtehtmi\u001b(B\u001b[0m\u001b[31m\u001b[40m, \u001b(B\u001b[0;1m\u001b[33m\u001b[40mGame Hunter\u001b(B\u001b[0m\u001b[31m\u001b[40m, \u001b(B\u001b[0;1m\u001b[33m\u001b[40mshark20061\u001b(B\u001b[0m\u001b[31m\u001b[40m, \u001b(B\u001b[0;1m\u001b[33m\u001b[40madd\u001b(B\u001b[0m\u001b[31m\u001b[40m and \u001b(B\u001b[0;1m\u001b[33m\u001b[40mbrisbang\u001b[19;13H\u001b(B\u001b[0m\u001b[31m\u001b[40mMusic tracks: \u001b(B\u001b[0;1m\u001b[33m\u001b[40mSonic Clang\u001b(B\u001b[0m\u001b[31m\u001b[40m (remixes), \u001b(B\u001b[0;1m\u001b[33m\u001b[40mSimon Volpert\u001b(B\u001b[0m\u001b[31m\u001b[40m (special levels)\u001b[20;13HHQ SFX      : \u001b(B\u001b[0;1m\u001b[33m\u001b[40mPer Kristian Risvik\u001b[21;13H\u001b(B\u001b[0m\u001b[31m\u001b[40mMajor changes since last version (see \u001b(B\u001b[0;1m\u001b[33m\u001b[40mversion.txt\u001b(B\u001b[0m\u001b[31m\u001b[40m for full list)\u001b[22;13H\u001b(B\u001b[0;1m\u001b[31m\u001b[40m  * tons of UI and UX changes, a lot new visual effects!\u001b(B\u001b[0m\u001b[37m\u001b[40m  \u001b[23;13H\u001b(B\u001b[0;1m\u001b[31m\u001b[40m  * new L4 special levels by brisbang, two new environment fluids!\u001b[24;13H  * enrage mechanic, infighting, more nightmare variants, tons little stuff!\u001b[25;13H  \u001b[26d\b\b\u001b[34m\u001b[40m facebook.com/ChaosForge  x.com/chaosforge_org  discord.gg/jupiterhell\u001b[27;13H\u001b[31m\u001b[40m\u001b[39X\u001b[27;52HPress <\u001b[33m\u001b[40mEnter\u001b[31m\u001b[40m> to continue...\u001b[3;11H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
