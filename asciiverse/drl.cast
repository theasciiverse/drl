[0.625, "o", "\u001b[17;12H\u001b(B\u001b[0;1m\u001b[33m\u001b[40mMarine\u001b[17;31H\u001b[31m\u001b[40m- \u001b[33m\u001b[40mMarine \u001b[31m\u001b[40m-\u001b[35b\u001b[18;12HScout\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[K\u001b[19;12H\u001b(B\u001b[0;1m\u001b[31m\u001b[40mTechnician\u001b[19;31H\u001b(B\u001b[0m\u001b[37m\u001b[40mMarines are the backbone of the UAC,\u001b[20;31Hresilient and hardy. They start with 10 more\u001b[21;31Hhealth points, +10% fire/acid/plasma\u001b[22;31Hresistance and powerups they use have a +50%\u001b[23;31Hduration bonus (+25% on Nightmare).\u001b[H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
